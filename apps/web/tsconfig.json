{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  // Read by the shadcn CLI to resolve the "@/" import alias.
  // No "baseUrl": it was removed in TypeScript 7; "paths" resolves relative to this file.
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
